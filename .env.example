# Copy to .env and fill in. .env is gitignored. chmod 600 .env after editing.

# AF account login — bot logs in before the strike
AF_USERNAME=
AF_PASSWORD=

# Payment card — auto-submitted at checkout
CARD_NUMBER=
CARD_CVV=
CARD_EXPIRY=MM/YY
CARD_HOLDER=

# Telegram (create a bot via @BotFather)
TELEGRAM_BOT_TOKEN=

# Email (SMTP) — OPTIONAL. Leave SMTP_USER blank to disable email; Telegram
# still works. For Gmail, SMTP_PASS must be an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
